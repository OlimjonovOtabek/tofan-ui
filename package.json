{
  "name": "tofan-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve admin",
    "start:staging": "nx serve admin --configuration=staging",
    "start:prod": "nx serve admin --configuration=prod",
    "start:coach": "nx serve coach",
    "start:coach:staging": "nx serve coach --configuration=staging",
    "start:coach:prod": "nx serve coach --configuration=prod",
    "start:landing": "nx serve landing",
    "build": "nx build admin",
    "build:coach": "nx build coach",
    "build:landing": "nx build landing",
    "serve:ssr:landing": "node dist/landing/server/server.mjs",
    "watch": "nx build admin --watch --configuration=development",
    "test": "nx run-many -t test -p admin core shared",
    "test:coach": "nx test coach",
    "test:landing": "nx test landing",
    "lint": "nx run-many -t lint && npm run lint:comments && npm run lint:boundaries",
    "lint:comments": "node scripts/check-no-comments.mjs",
    "lint:boundaries": "sheriff verify",
    "format": "prettier --write \"apps/**/*.{ts,html,css}\" \"libs/**/*.{ts,html,css}\""
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "@openng/icons": "^1.0.0",
    "@openng/optimus-ui": "^2.0.2",
    "@openng/optimus-ui-themes": "^2.0.2",
    "express": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@nx/workspace": "23.3.0",
    "@openng/optimus-ui-tailwindcss": "^2.0.2",
    "@softarc/sheriff-core": "^0.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.1",
    "nx": "23.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
