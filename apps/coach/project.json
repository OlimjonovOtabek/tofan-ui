{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "coach",
  "projectType": "application",
  "root": "apps/coach",
  "sourceRoot": "apps/coach/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "ng build coach" },
      "outputs": ["{workspaceRoot}/dist/coach/browser"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "ng serve coach" },
      "configurations": {
        "staging": { "command": "ng serve coach --configuration=staging" },
        "prod": { "command": "ng serve coach --configuration=prod" },
        "production": { "command": "ng serve coach --configuration=production" }
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "ng test coach --watch=false" },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "ng lint coach" },
      "cache": true
    }
  }
}
