FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build:coach

FROM nginx:1.31-alpine
ENV API_UPSTREAM=http://tofan-api:8080 \
    NGINX_RESOLVER=127.0.0.11 \
    FIREBASE_PUBLIC_API_KEY=AIzaSyDt2CYne5vyOA3S_jFjQYrA1a5vpwtuoBs \
    FIREBASE_APP_ID=1:16797826601:web:b3e3840399c07d7cd76638 \
    FIREBASE_PROJECT_ID=tofan-68065 \
    FIREBASE_MESSAGING_SENDER_ID=16797826601 \
    FIREBASE_PUBLIC_VAPID_KEY=
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/security-headers.inc /etc/nginx/snippets/security-headers.inc
COPY --chmod=0755 nginx/push-config.sh /docker-entrypoint.d/40-push-config.sh
COPY --from=build /app/dist/coach/browser /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
